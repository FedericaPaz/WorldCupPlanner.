@using Web.Services
@inject SessionService SessionService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">WorldCup Planner 2026</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Usuarios
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="teams">
                <span class="bi bi-trophy-fill-nav-menu" aria-hidden="true"></span> Equipos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="stadiums">
                <span class="bi bi-geo-alt-fill-nav-menu" aria-hidden="true"></span> Estadios
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fixture">
                <span class="bi bi-calendar-event-fill-nav-menu" aria-hidden="true"></span> Fixture
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cruces">
                <span class="bi bi-calendar-event-fill-nav-menu" aria-hidden="true"></span> Cruces
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="matches">
                <span class="bi bi-list-ul-nav-menu" aria-hidden="true"></span> Partidos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="import">
                <span class="bi bi-upload-nav-menu" aria-hidden="true"></span> Importar
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="logs">
                <span class="bi bi-clipboard-data-nav-menu" aria-hidden="true"></span> Log
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <button @onclick="HandleLogout" class="nav-link logout-button">
                Cerrar sesión (@SessionService.GetCurrentUser()?.Name)
            </button>
        </div>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        await SessionService.LogOut();
        Navigation.NavigateTo("/login");
    }
}