@using Web.Services
@inject SessionService SessionService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">WorldCup Planner 2026</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        @if (!(SessionService.IsSystemAdministrator() && SessionService.IsEditor()))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door-fill"></i>Inicio
                </NavLink>
            </div>
        }

        @if (SessionService.IsSystemAdministrator())
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <i class="bi bi-people-fill"></i> Usuarios
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="stadiums">
                    <i class="bi bi-geo-alt-fill"></i> Estadios
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="logs">
                    <i class="bi bi-clipboard-data"></i> Log
                </NavLink>
            </div>
        }

        @if (SessionService.IsSystemAdministrator() || SessionService.IsEditor() || SessionService.IsJournalist())
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="teams">
                    <i class="bi bi-trophy-fill"></i> Equipos
                </NavLink>
            </div>
        }

        @if (SessionService.IsEditor() || SessionService.IsJournalist())
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="fixture">
                    <i class="bi bi-calendar-event-fill"></i> Fixture
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="matches">
                    <i class="bi bi-list-ul"></i> Partidos
                </NavLink>
            </div>
        }

        @if (SessionService.IsEditor())
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="cruces">
                    <i class="bi bi-calendar-event-fill"></i>  Cruces
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="import">
                    <i class="bi bi-upload"></i> Importar
                </NavLink>
            </div>
        }

        @if (SessionService.IsSystemAdministrator() || SessionService.IsJournalist())
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="export">
                    <i class="bi bi-download"></i> Exportaciones
                </NavLink>
            </div>
        }

        @if (SessionService.IsJournalist())
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="notifications">
                    <i class="bi bi-bell-fill"></i> Notificaciones
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <button @onclick="HandleLogout" class="nav-link logout-button">
                Cerrar sesión (@SessionService.GetCurrentUser()?.Name)
            </button>
        </div>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        await SessionService.LogOut();
        Navigation.NavigateTo("/login");
    }
}