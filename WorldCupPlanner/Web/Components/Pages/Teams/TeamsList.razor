@page "/teams"
@using DTOs.Team
@using IServices
@using IServices.TeamInterfaces
@using Web.Services
@inject ITeamQueryService TeamQueryService
@inject ITeamEditService TeamEditService
@inject ILogService LogService
@inject SessionService SessionService
@inject NavigationManager Navigation
@inject IConfigService ConfigService

<div class="row align-items-center mb-3">
    <div class="col">
        <h3 class="mb-0">@PageTitle</h3>
        <span>@_teams.Count equipos registrados (se requieren 48)</span>
    </div>

    @if (CanManageTeams())
    {
        <div class="col-auto">
            <button class="btn btn-primary btn-bg-green" @onclick="GoToGenerate">
                Generar equipos
            </button>
        </div>

        <div class="col-auto">
            <button class="btn btn-primary btn-bg-green" @onclick="GoToCreate">
                + Crear equipo
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_teams.Count == 0)
{
    <p>No hay equipos cargados todavía.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Ranking FIFA</th>
            <th>Bandera</th>
            <th>Nombre</th>
            <th>Confederación</th>
            <th>Acciones</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var team in _teams.OrderBy(t => t.CurrentRanking))
        {
            <tr>
                <td>@team.CurrentRanking</td>

                <td>
                    @if (!string.IsNullOrWhiteSpace(team.FlagBase64))
                    {
                        var cleanBase64 = team.FlagBase64.Replace("\r", "").Replace("\n", "").Trim();
        
                        <img src="data:image/png;base64,@cleanBase64" 
                             alt="Bandera de @team.Name" 
                             style="width: 32px; height: 22px; object-fit: cover;" />
                    }
                </td>

                <td>@team.Name</td>
                <td class="confederation">@team.ConfederationName</td>

                @if (CanManageTeams())
                {
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2 edit-button"
                                type="button"
                                @onclick="() => GoToEdit(team.Name)">
                            <i class="bi bi-pencil"></i>
                        </button>

                        <button class="btn btn-sm btn-outline-danger"
                                type="button"
                                @onclick="() => DeleteTeam(team.Name)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                }
                else
                {
                    <td>
                        <span class="text-muted">Solo lectura</span>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<TeamDTO> _teams = new();
    private string? _errorMessage;

    private string PageTitle =>
        SessionService.IsJournalist()
            ? "Equipos y rankings"
            : "Gestión de equipos";

    protected override void OnInitialized()
    {
        if (!SessionService.IsSystemAdministrator() &&
            !SessionService.IsEditor() &&
            !SessionService.IsJournalist())
        {
            Navigation.NavigateTo("/");
            return;
        }

        LoadTeams();
    }

    private void LoadTeams()
    {
        try
        {
            _errorMessage = null;
            _teams = TeamQueryService.GetAll();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private bool CanManageTeams()
    {
        return SessionService.IsSystemAdministrator() || SessionService.IsEditor();
    }

    private void GoToCreate()
    {
        if (!CanManageTeams())
        {
            return;
        }

        Navigation.NavigateTo("/teamsCreate");
    }

    private void GoToGenerate()
    {
        if (!CanManageTeams())
        {
            return;
        }

        try
        {
            _errorMessage = null;

            TeamEditService.GenerateMissingTeams();

            LogService.Register(
                GetCurrentUserEmail(),
                "Equipos",
                "Generación automática",
                $"Se generaron automáticamente los equipos faltantes con semilla {ConfigService.GetConfig().SemillaCompletar}"
            );

            LoadTeams();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void GoToEdit(string name)
    {
        if (!CanManageTeams())
        {
            return;
        }

        Navigation.NavigateTo($"/teams/edit/{name}");
    }

    private void DeleteTeam(string name)
    {
        if (!CanManageTeams())
        {
            return;
        }

        try
        {
            _errorMessage = null;

            TeamEditService.Delete(name);

            LogService.Register(
                GetCurrentUserEmail(),
                "Equipos",
                "Eliminación",
                $"Se eliminó el equipo {name}"
            );

            LoadTeams();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser()!.Email;
    }
}