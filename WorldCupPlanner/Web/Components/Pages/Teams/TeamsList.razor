@page "/teams"
@using DTOs
@using IServices
@using Web.Services

@inject ITeamService TeamService
@inject ILogService LogService
@inject SessionService SessionService
@inject NavigationManager Navigation
@inject IFixtureService FixtureService

<div class="teams-page">
    <div class="teams-header">
        <div>
            <h1>Gestión de equipos</h1>
            <p>@_teams.Count equipos registrados de 48 requeridos</p>
        </div>

        <div class="teams-header-actions">
            <button class="secondary-action-button" @onclick="GoToGenerate">
                ✨ Generar equipos
            </button>

            <button class="primary-action-button" @onclick="GoToCreate">
                + Crear equipo
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="teams-message error">
            @_errorMessage
        </div>
    }
    else if (_teams.Count == 0)
    {
        <div class="teams-empty">
            <div class="teams-empty-icon">⚽</div>
            <h3>No hay equipos cargados todavía</h3>
            <p>Creá equipos manualmente o generá los equipos faltantes automáticamente.</p>
        </div>
    }
    else
    {
        <div class="teams-card">
            <table class="teams-table">
                <thead>
                    <tr>
                        <th>Ranking FIFA</th>
                        <th>Nombre</th>
                        <th>Confederación</th>
                        <th class="teams-actions-column">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var team in _teams.OrderBy(t => t.FifaRanking))
                    {
                        <tr>
                            <td>
                                <span class="ranking-badge">
                                    @team.FifaRanking
                                </span>
                            </td>

                            <td class="team-name">
                                @team.Name
                            </td>

                            <td>
                                <span class="confederation-badge">
                                    @team.ConfederationName
                                </span>
                            </td>

                            <td class="teams-actions-cell">
                                <button class="table-action-button edit" type="button" @onclick="() => GoToEdit(team.Name)">
                                    Editar
                                </button>

                                <button class="table-action-button danger" type="button" @onclick="() => DeleteTeam(team.Name)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<TeamDTO> _teams = new();
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        LoadTeams();
    }

    private void LoadTeams()
    {
        try
        {
            _errorMessage = null;
            _teams = TeamService.GetAll();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo("/teamsCreate");
    }

    private void GoToGenerate()
    {
        try
        {
            _errorMessage = null;
            TeamService.GenerateMissingTeams();
            LoadTeams();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void GoToEdit(string name)
    {
        Navigation.NavigateTo($"/teams/edit/{Uri.EscapeDataString(name)}");
    }

    private void DeleteTeam(string name)
    {
        try
        {
            _errorMessage = null;
            bool habiaFixture = FixtureService.HasFixture();
            TeamService.Delete(name);
            
            if (habiaFixture)
                _errorMessage = "⚠️ El equipo fue eliminado. El fixture y los cruces fueron reiniciados.";
        
            LogService.Register(
                GetCurrentUserEmail(),
                "Equipos",
                "Eliminación",
                $"Se eliminó el equipo {name}"
            );

            LoadTeams();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
    
    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser().Email;
    }
    
    
}