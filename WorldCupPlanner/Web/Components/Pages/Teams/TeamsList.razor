@page "/teams"
@using DTOs
@using IServices
@inject ITeamService TeamService
@inject NavigationManager Navigation

<div class="row align-items-center mb-3">
    <div class="col">
        <h3 class="mb-0">Gestión de equipos</h3>
        <span>@_teams.Count equipos registrados (se requieren 48)</span>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="GoToGenerate">
            ✨ Generar equipos
        </button>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="GoToCreate">
            + Crear equipo
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_teams.Count == 0)
{
    <p>No hay equipos cargados todavía.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Ranking FIFA</th>
            <th>Nombre</th>
            <th>Confederación</th>
            <th>Acciones</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var team in _teams.OrderBy(t => t.FifaRanking))
        {
            <tr>
                <td>@team.FifaRanking</td>
                <td>@team.Name</td>
                <td>@team.ConfederationName</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-2" type="button" @onclick="() => GoToEdit(team.Name)">
                        ✏️ Editar
                    </button>
                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteTeam(team.Name)">
                        🗑️ Eliminar
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<TeamDTOs.TeamResponseDTO> _teams = new();
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        LoadTeams();
    }

    private void LoadTeams()
    {
        try
        {
            _errorMessage = null;
            _teams = TeamService.GetAll();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo("/teamsCreate");
    }
    
    private void GoToGenerate()
    {
        Navigation.NavigateTo("/teamsGenerate");
    }
    
    private void GoToEdit(string name)
    {
        Navigation.NavigateTo($"/teams/edit/{name}");
    }
    
    private void DeleteTeam(string name)
    {
        try
        {
            _errorMessage = null;
            TeamService.Delete(name);
            LoadTeams();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}