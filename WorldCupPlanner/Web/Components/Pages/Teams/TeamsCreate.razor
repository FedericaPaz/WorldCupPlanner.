@page "/teamsCreate"
@using DTOs
@using IServices
@using Web.Services

@inject ITeamService TeamService
@inject ILogService LogService
@inject SessionService SessionService
@inject NavigationManager Navigation

<div class="team-form-page">
    <div class="team-form-back">
        <button class="link-back-button" @onclick="GoBack">
            ← Volver a equipos
        </button>
    </div>

    <div class="team-form-card">
        <div class="team-form-header">
            <div class="team-form-icon">⚽</div>

            <div>
                <h1>Crear equipo</h1>
                <p>Complete la información del equipo participante</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="teams-message error">
                @_errorMessage
            </div>
        }

        <EditForm Model="_request" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="team-form-section">
                <label>Nombre</label>
                <InputText class="team-form-control" @bind-Value="_request.Name" />
            </div>

            <div class="team-form-section">
                <label>Confederación</label>
                <InputSelect class="team-form-control" @bind-Value="_request.ConfederationName">
                    <option value="">Seleccione una confederación...</option>
                    @foreach (var conf in _confederations)
                    {
                        <option value="@conf.Name">@conf.Name (@conf.MaxTeams cupos máximos)</option>
                    }
                </InputSelect>
            </div>

            <div class="team-form-section">
                <label>Ranking FIFA</label>
                <InputNumber class="team-form-control"
                             @bind-Value="_request.FifaRanking"
                             DisplayName="Ranking FIFA"
                             ParsingErrorMessage="El campo {0} debe ser un número." />
            </div>

            <div class="team-form-actions">
                <button type="button" class="secondary-action-button" @onclick="GoBack">
                    Cancelar
                </button>

                <button type="submit" class="primary-action-button">
                    Crear equipo
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private TeamDTO _request = new()
    {
        Name = "",
        ConfederationName = "",
        FifaRanking = 0
    };

    private List<ConfederationDTO> _confederations = new();
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _confederations = TeamService.GetAllConfederations();
    }

    private void HandleSubmit()
    {
        try
        {
            _errorMessage = null;

            TeamService.Add(_request);

            LogService.Register(
                GetCurrentUserEmail(),
                "Equipos",
                "Alta",
                $"Se creó el equipo {_request.Name}"
            );

            Navigation.NavigateTo("/teams");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/teams");
    }

    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser().Email;
    }
}