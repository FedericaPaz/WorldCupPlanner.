@page "/teamsCreate"
@using DTOs.Team
@using IServices.PageFacades
@using Web.Services

@inject ITeamPageFacade TeamFacade
@inject SessionService SessionService
@inject NavigationManager Navigation

<div class="team-form-page">
    <div class="team-form-back">
        <button class="link-back-button" @onclick="GoBack">
            ← Volver a equipos
        </button>
    </div>

    <div class="team-form-card">
        <div class="team-form-header">
            <i class="bi-pencil-square team-form-icon"></i>

            <div>
                <h1>Crear equipo</h1>
                <p>Complete la información del equipo participante</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="teams-message error">
                @_errorMessage
            </div>
        }

        <EditForm Model="_request" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="team-form-section">
                <label>Nombre</label>
                <InputText class="team-form-control" @bind-Value="_request.Name" />
                <ValidationMessage For="@(() => _request.Name)" />
            </div>

            <div class="team-form-section">
                <label>Confederación</label>
                <InputSelect class="team-form-control" @bind-Value="_request.ConfederationName">
                    <option value="">Seleccione una confederación...</option>
                    @foreach (var conf in _confederations)
                    {
                        <option value="@conf.Name">@conf.Name (@conf.MaxTeams cupos máximos)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _request.ConfederationName)" />
            </div>

            <div class="team-form-section">
                <label>Ranking FIFA</label>
                <InputNumber class="team-form-control"
                             @bind-Value="_request.FifaRanking"
                             DisplayName="Ranking FIFA"
                             ParsingErrorMessage="El campo {0} debe ser un número." />
                <ValidationMessage For="@(() => _request.FifaRanking)" />
            </div>

            <div class="team-form-section">
                <label>Bandera</label>
                <InputFile OnChange="LoadFlag" accept="image/*" />

                @if (!string.IsNullOrWhiteSpace(_request.FlagBase64))
                {
                    <img src="@($"data:{_flagContentType};base64,{_request.FlagBase64}")"
                         alt="Bandera del equipo"
                         style="max-width: 120px; margin-top: 10px;" />
                }
            </div>

            <div class="team-form-actions">
                <button type="button" class="secondary-action-button" @onclick="GoBack">
                    Cancelar
                </button>

                <button type="submit" class="primary-action-button">
                    Crear equipo
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private TeamDTO _request = new()
    {
        Name = "",
        ConfederationName = "",
        FifaRanking = 0
    };

    private List<ConfederationDTO> _confederations = new();
    private string? _errorMessage;
    private string? _flagContentType;

    protected override void OnInitialized()
    {
        if (!SessionService.IsSystemAdministrator() && !SessionService.IsEditor())
        {
            Navigation.NavigateTo("/");
            return;
        }
        _confederations = TeamFacade.GetAllConfederations();
    }

    private void HandleSubmit()
    {
        try
        {
            _errorMessage = null;
            TeamFacade.Add(_request, GetCurrentUserEmail());
            Navigation.NavigateTo("/teams");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/teams");

    private string GetCurrentUserEmail() =>
        SessionService.IsUserActive() ? SessionService.GetCurrentUser()!.Email : "Sistema";

    private async Task LoadFlag(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);

        _flagContentType = file.ContentType;
        string rawBase64 = Convert.ToBase64String(memoryStream.ToArray());
        _request.FlagBase64 = rawBase64.Replace("\r", "").Replace("\n", "").Trim();
    }
}