@page "/Fixture"
@using DTOs
@using IServices
@inject IFixtureService FixtureService
@inject NavigationManager Navigation

<h3 class="text-center my-4">Fixture - Fase de Grupos</h3>

@if (_fixture == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p>Cargando fixture...</p>
    </div>
} 
else if (!_fixture.Groups.Any())
{
    <div class="alert alert-warning text-center">
        <h4>No hay fixture generado</h4>
        <p>Generar Fixture con el boton de generar Fixture.</p>
        <button class="btn btn-primary mt-2" @onclick="NavigateToGenerate">
            Generar Fixture
        </button>
    </div>
}
else
{
    <div class="container">
        <div class="row g-3">
            @foreach (var group in _fixture.Groups)
            {
                <div class="col-md-3 col-sm-6">
                    <div class="card group-card h-100 shadow-sm" 
                         @onclick="() => SelectGroup(group)">
                        <div class="card-header text-center bg-dark text-white">
                            <h4 class="mb-0">Grupo @group.GroupLetter</h4>
                        </div>
                        <div class="card-body">
                            @foreach (var team in group.Teams)
                            {
                                <div class="team-item">
                                    <span class="team-flag">⚽</span>
                                    <span class="team-name">@team.Name</span>
                                </div>
                            }
                        </div>
                        <div class="card-footer text-center text-muted small">
                            @group.Matches.Count partidos
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (SelectedGroup != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-container">
            <div class="modal-header">
                <h4>Grupo @SelectedGroup.GroupLetter</h4>
                <button class="btn-close" @onclick="CloseModal">✖</button>
            </div>
            <div class="modal-body">
                <GroupDetail Group="SelectedGroup" 
                             OnStandingsUpdated="RefreshStandings" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private FixtureResponse _fixture;
    private GroupResponse SelectedGroup { get; set; }

    protected override void OnInitialized()
    {
        _fixture = FixtureService.GetFixture();
    }
    
    private void LoadFixture()
    {
        _fixture = FixtureService.GetFixture();
        StateHasChanged();
    }
    
    private void SelectGroup(GroupResponse group)
    {
        SelectedGroup = group;
    }
    
    private void CloseModal()
    {
        SelectedGroup = null;
        LoadFixture();
    }
    
    private void RefreshStandings()
    {
        LoadFixture();
    }
    
    private void NavigateToGenerate()
    {
        Navigation.NavigateTo("/admin/generate-fixture");
    }
}