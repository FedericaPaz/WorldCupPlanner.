@page "/fixture"
@using DTOs.Fixture
@using IServices
@using Web.Services
@inject IFixtureService FixtureService
@inject ITeamService TeamService
@inject IStadiumService StadiumService
@inject NavigationManager Navigation
@inject ILogService LogService
@inject SessionService SessionService
@inject IConfigService ConfigService
@inject IMatchService MatchService

<h3 class="text-center my-4">Fixture - Fase de Grupos</h3>

@if (_isGenerating)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Generando...</span>
        </div>
        <p class="mt-3">Generando fixture...</p>
    </div>
}
else if (!FixtureService.HasFixture())
{
    <div class="container">
        <div class="text-center py-5">
            <h4>No hay fixture generado</h4>
            <p class="text-muted">Se necesitan 48 equipos y al menos 4 estadios para generar el fixture.</p>

            <div class="d-flex justify-content-center gap-4 my-3">
                <div>
                    <span class="@(_teamCount >= 48 ? "text-success" : "text-danger") fw-bold fs-5">
                        @_teamCount
                    </span>
                    <span class="text-muted"> / 48 equipos</span>
                </div>

                <div>
                    <span class="@(_stadiumCount >= 4 ? "text-success" : "text-danger") fw-bold fs-5">
                        @_stadiumCount
                    </span>
                    <span class="text-muted"> / 4 estadios</span>
                </div>
            </div>

            @if (_canGenerate && SessionService.IsEditor())
            {
                <div class="mt-3">
                    <label class="form-label">Motor de simulación</label>
                    <select class="form-select w-auto" @bind="_selectedEngine">
                        <option value="Probabilístico">Probabilístico</option>
                        <option value="Aleatorio puro">Aleatorio puro</option>
                    </select>
                </div>

                <button class="btn btn-success btn-lg mt-3" @onclick="GenerateInitialFixture">
                    Generar Fixture
                    <i class="bi-dribbble"></i>
                </button>
            }
            else if (SessionService.IsEditor())
            {
                <p class="text-muted mt-3">Completá los requisitos para habilitar la generación.</p>
            }
            else
            {
                <p class="text-muted mt-3">El fixture todavía no fue generado.</p>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger mt-3 mx-auto" style="max-width: 500px;">
                    @_error
                </div>
            }
        </div>
    </div>
}
else
{
    var fixture = FixtureService.GetFixture();

    <div class="container">
        <div class="mb-3">
            <p class="text-muted small">Motor de simulación: <strong>@fixture.SimulationEngineName</strong></p>
        </div>

        @if (SessionService.IsEditor())
        {
            <div class="d-flex flex-column gap-2 mb-3">

                @if (!_showRegenerateOptions)
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-success" @onclick="MostrarOpcionesRegenerar">
                            ⚽ ReGenerar Fixture
                        </button>
                        <button class="btn btn-outline-danger" @onclick="EliminarFixture" disabled="@_isReloading">
                            🗑 Eliminar Fixture
                        </button>
                    </div>
                }

                @if (_showRegenerateOptions && _matchesHaveBeenPlayed)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-3 mb-0">
                        <span style="font-size:1.5rem">⚠️</span>
                        <div class="flex-grow-1">
                            <strong>Hay partidos con resultados cargados.</strong>
                            <p class="mb-0 small">Si regenerás el fixture se perderán todos los resultados.</p>
                        </div>
                    </div>
                }

                @if (_showRegenerateOptions)
                {
                    <div class="d-flex align-items-end gap-3">
                        <div>
                            <label class="form-label fw-bold mb-1">Motor de simulación</label>
                            <select class="form-select w-auto" @bind="_selectedEngine" disabled="@_isReloading">
                                <option value="Probabilístico">Probabilístico</option>
                                <option value="Aleatorio puro">Aleatorio puro</option>
                            </select>
                        </div>
                        <button class="btn btn-success" @onclick="RegenerateFixture" disabled="@_isReloading">
                            ⚽ Confirmar Regenerar
                        </button>
                        <button class="btn btn-secondary" @onclick="() => _showRegenerateOptions = false" disabled="@_isReloading">
                            Cancelar
                        </button>
                    </div>
                }

            </div>
        }

        <div class="row g-3 reload-container">
            @if (_isReloading)
            {
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-3">Generando nuevos grupos...</p>
                </div>
            }
            else
            {
                @foreach (var group in fixture.Groups)
                {
                    <div class="col-md-3 col-sm-6 fade-in">
                        <div class="card group-card h-100 shadow-sm" role="button" @onclick="() => SelectGroup(group)">
                            <div class="card-header text-center bg-dark text-white">
                                <h4 class="mb-0">Grupo @group.GroupLetter</h4>
                            </div>
                            <div class="card-body">
                                @foreach (var team in group.Teams)
                                {
                                    <div class="team-item d-flex align-items-center gap-2 py-1">
                                        <span><i class="bi bi-dribbble"></i></span>
                                        <span>@team.Name</span>
                                    </div>
                                }
                            </div>
                            <div class="card-footer text-center text-muted small">
                                @group.Matches.Count partidos
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@if (SelectedGroup != null)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4>Grupo @SelectedGroup.GroupLetter</h4>
                <button class="btn-close" @onclick="CloseModal">✖</button>
            </div>

            <div class="modal-body">
                <GroupDetail Group="SelectedGroup" />
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isGenerating;
    private string? _error;
    private int _teamCount;
    private int _stadiumCount;
    private bool _canGenerate;
    private GroupResponse? SelectedGroup { get; set; }
    private bool _isReloading = false;
    private string _selectedEngine = "Probabilístico";
    private bool _showRegenerateOptions = false;
    private bool _matchesHaveBeenPlayed = false;

    protected override void OnInitialized()
    {
        if (!SessionService.IsEditor() && !SessionService.IsJournalist())
        {
            Navigation.NavigateTo("/");
            return;
        }
        
        _matchesHaveBeenPlayed = MatchService.MatchesHaveBeenPlayed();

        _teamCount = TeamService.GetAll().Count;
        _stadiumCount = StadiumService.GetAllStadiums().Count;
        _canGenerate = _teamCount >= 48 && _stadiumCount >= 4;
    }

    private void GenerateInitialFixture()
    {
        if (!SessionService.IsEditor())
        {
            return;
        }

        _isGenerating = true;
        _error = null;

        try
        {
            FixtureService.GenerateFixture(_selectedEngine);

            LogService.Register(
                GetCurrentUserEmail(),
                "Fixture",
                "Generación",
                $"Se generó el fixture del torneo con semilla {ConfigService.GetConfig().SemillaFixture}"
            );
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }


    private async Task EliminarFixture()
    {
        if (!SessionService.IsEditor())
        {
            return;
        }
        if (_isReloading)
        {
            return;
        }
        _isReloading = true;
        _error = null;
        StateHasChanged();
        try
        {
            await Task.Delay(500);

            FixtureService.DeleteFixture(FixtureService.GetFixtureEntity());

            LogService.Register(
                GetCurrentUserEmail(),
                "Fixture",
                "Generación",
                $"Se elimino el fixture generado con:  {ConfigService.GetConfig().SemillaFixture}"
            );
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isReloading = false;
            StateHasChanged();
        }
    }
    
    private async Task RegenerateFixture()
    {
        if (!SessionService.IsEditor())
        {
            return;
        }

        if (_isReloading)
        {
            return;
        }

        _isReloading = true;
        _error = null;
        StateHasChanged();

        try
        {
            await Task.Delay(500);

            FixtureService.GenerateFixture(_selectedEngine);

            LogService.Register(
                GetCurrentUserEmail(),
                "Fixture",
                "Generación",
                $"Se regeneró el fixture del torneo con semilla {ConfigService.GetConfig().SemillaFixture}"
            );

            _showRegenerateOptions = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isReloading = false;
            StateHasChanged();
        }
    }

    private void SelectGroup(GroupResponse group)
    {
        SelectedGroup = group;
        StateHasChanged();
    }

    private void CloseModal()
    {
        SelectedGroup = null;
        StateHasChanged();
    }

    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser()!.Email;
    }
    
    private void MostrarOpcionesRegenerar()
    {
        _showRegenerateOptions = true;
        StateHasChanged();
    }
}