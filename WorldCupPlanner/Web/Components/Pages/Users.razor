@page "/users"
@using Domain
@using DTOs.User
@using global::Services
@using IServices
@using Web.Services
@using global::Services.Mappers

@inject UserService UserService
@inject ILogService LogService
@inject SessionService SessionService

<div class="users-shell">
    <div class="users-header">
        <div>
            <h1>Gestión de Usuarios</h1>
            <p>Administre los usuarios del sistema</p>
        </div>

        <button class="primary-button" @onclick="OpenCreateModal">
            <span class="plus-icon">+</span>
            Crear usuario
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_pageErrorMessage))
    {
        <div class="error-message">
            @_pageErrorMessage
        </div>
    }

    <div class="users-table-card">
        <table class="users-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Fecha Nacimiento</th>
                    <th>Roles</th>
                    <th class="actions-column">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (_users.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            No hay usuarios registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in _users)
                    {
                        <tr>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td class="muted">@user.Email</td>
                            <td class="muted">@user.BirthDate.ToString("yyyy-MM-dd")</td>
                            <td class="muted">@FormatRoles(user.Roles)</td>
                            <td class="actions-cell">
                                <button class="icon-button" @onclick="() => OpenEditModal(user)">
                                    Editar
                                </button>

                                <button class="icon-button danger" @onclick="() => DeleteUser(user.Email)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (_showCreateModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h2>@(_isEditing ? "Editar Usuario" : "Crear Usuario")</h2>

                <button class="close-button" @onclick="CloseCreateModal">
                    ×
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_modalErrorMessage))
            {
                <div class="error-message">
                    @_modalErrorMessage
                </div>
            }

            <EditForm Model="_userRequest" OnValidSubmit="SubmitUser">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>Nombre</label>
                    <InputText class="form-control" @bind-Value="_userRequest.FirstName" />
                    <ValidationMessage For="@(() => _userRequest.FirstName)" />
                </div>

                <div class="form-group">
                    <label>Apellido</label>
                    <InputText class="form-control" @bind-Value="_userRequest.LastName" />
                    <ValidationMessage For="@(() => _userRequest.LastName)" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <InputText class="form-control" @bind-Value="_userRequest.Email" disabled="@_isEditing" />
                    <ValidationMessage For="@(() => _userRequest.Email)" />
                </div>

                <div class="form-group">
                    <label>Fecha de Nacimiento</label>
                    <InputDate class="form-control" @bind-Value="_userRequest.BirthDate" />
                    <ValidationMessage For="@(() => _userRequest.BirthDate)" />
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <InputText type="password" class="form-control" @bind-Value="_userRequest.Password" />
                    <ValidationMessage For="@(() => _userRequest.Password)" />
                </div>

                <div class="form-group">
                    <label>Roles</label>

                    <div class="roles-options">
                        <label class="role-option">
                            <input type="checkbox"
                                   checked="@_userRequest.Roles.Contains(UserRoleDto.SystemAdministrator)"
                                   @onchange="ToggleSystemAdministratorRole" />
                            Administrador
                        </label>

                        <label class="role-option">
                            <input type="checkbox"
                                   checked="@_userRequest.Roles.Contains(UserRoleDto.Editor)"
                                   @onchange="ToggleEditorRole" />
                            Editor
                        </label>
                    </div>
                </div>

                <div class="modal-actions">
                    <button type="button" class="secondary-button" @onclick="CloseCreateModal">
                        Cancelar
                    </button>

                    <button type="submit" class="primary-button full">
                        @(_isEditing ? "Actualizar" : "Crear")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<User> _users = new();
    private UserRequestDto _userRequest = new();
    private bool _showCreateModal;
    private bool _isEditing;
    private string _editingEmail = string.Empty;
    private string _pageErrorMessage = string.Empty;
    private string _modalErrorMessage = string.Empty;

    protected override void OnInitialized()
    {
        LoadUsers();
    }

    private void LoadUsers()
    {
        _users = UserService.GetAllUsers();
    }

    private void OpenCreateModal()
    {
        _pageErrorMessage = string.Empty;
        _modalErrorMessage = string.Empty;
        _isEditing = false;
        _editingEmail = string.Empty;

        _userRequest = new UserRequestDto
        {
            BirthDate = DateTime.Today,
            Roles = new List<UserRoleDto>()
        };

        _showCreateModal = true;
    }

    private void OpenEditModal(User user)
    {
        _pageErrorMessage = string.Empty;
        _modalErrorMessage = string.Empty;
        _isEditing = true;
        _editingEmail = user.Email;

        _userRequest = new UserRequestDto
        {
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email,
            BirthDate = user.BirthDate,
            Password = string.Empty,
            Roles = UserRoleMapper.ToDto(user.Roles)
        };

        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _isEditing = false;
        _editingEmail = string.Empty;
        _modalErrorMessage = string.Empty;
    }

    private void SubmitUser()
    {
        try
        {
            _modalErrorMessage = string.Empty;
            var currentUserEmail = GetCurrentUserEmail();

            if (_isEditing)
            {
                UserService.UpdateUser(
                    _userRequest.FirstName,
                    _userRequest.LastName,
                    _editingEmail,
                    _userRequest.BirthDate,
                    _userRequest.Password,
                    UserRoleMapper.ToDomain(_userRequest.Roles)
                );

                LogService.Register(
                    currentUserEmail,
                    "Usuarios",
                    "Edición",
                    $"Se editó el usuario {_editingEmail}"
                );
            }
            else
            {
                UserService.CreateUser(_userRequest);

                LogService.Register(
                    currentUserEmail,
                    "Usuarios",
                    "Alta",
                    $"Se creó el usuario {_userRequest.Email}"
                );
            }

            LoadUsers();
            CloseCreateModal();
        }
        catch (Exception exception)
        {
            _modalErrorMessage = exception.Message;
        }
    }

    private void DeleteUser(string email)
    {
        try
        {
            _pageErrorMessage = string.Empty;
            UserService.DeleteUser(email);

            LogService.Register(
                GetCurrentUserEmail(),
                "Usuarios",
                "Eliminación",
                $"Se eliminó el usuario {email}"
            );

            LoadUsers();
        }
        catch (Exception exception)
        {
            _pageErrorMessage = exception.Message;
        }
    }

    private void ToggleSystemAdministratorRole(ChangeEventArgs args)
    {
        ToggleRole(UserRoleDto.SystemAdministrator, args);
    }

    private void ToggleEditorRole(ChangeEventArgs args)
    {
        ToggleRole(UserRoleDto.Editor, args);
    }

    private void ToggleRole(UserRoleDto role, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;

        if (isChecked && !_userRequest.Roles.Contains(role))
        {
            _userRequest.Roles.Add(role);
        }

        if (!isChecked && _userRequest.Roles.Contains(role))
        {
            _userRequest.Roles.Remove(role);
        }
    }

    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser().Email;
    }

    private string FormatRoles(List<UserRole> roles)
    {
        if (roles.Count == 0)
        {
            return "Sin rol";
        }

        var roleNames = roles.Select(role =>
            role == UserRole.SystemAdministrator ? "Administrador" : "Editor"
        );

        return string.Join(", ", roleNames);
    }
}