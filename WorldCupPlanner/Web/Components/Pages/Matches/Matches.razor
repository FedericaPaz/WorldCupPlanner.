@page "/matches"
@rendermode InteractiveServer
@using DTOs
@using IServices
@inject IMatchService MatchService
@inject ICruceService CruceService

<div class="matches-page">
    <div class="page-header">
        <div>
            <h3>Listado de Partidos</h3>
            <p>@_pendientes pendientes · @_jugados jugados · @_matches.Count total</p>
        </div>
        @if (_pendientes > 0)
        {
            <button class="btn-generar-cruces" @onclick="SimularPendientes" disabled="@_cargando">
                @(_cargando ? "⏳ Simulando..." : $"🎲 Simular pendientes ({_pendientes})")
            </button>
        }
    </div>

    <div class="matches-card">
        <table class="matches-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Equipos</th>
                    <th>Resultado</th>
                    <th>Estadio</th>
                    <th>Fase</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var match in _matches)
                {
                    <tr>
                        <td class="date-cell">
                            @match.dateMatch.ToString("dd/MM/yyyy,")
                            <br />
                            @match.dateMatch.ToString("HH:mm")
                        </td>

                        <td class="teams-cell">
                            @match.homeTeamName vs @match.awayTeamName
                        </td>

                        <td>
                            @if (match.homeGoals.HasValue && match.awayGoals.HasValue)
                            {
                                <span class="result-pill">
                                    @match.homeGoals - @match.awayGoals
                                </span>
                            }
                            else
                            {
                                <span class="no-result">-</span>
                            }
                        </td>

                        <td class="stadium-cell">
                            @match.stadiumName
                        </td>

                        <td>
                            <span class="phase-pill">Grupo @match.group</span>
                        </td>

                        <td>
                            <a class="edit-button" href="/matches/edit/@match.idMatch">✎</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<MatchResponse> _matches = new();
    private bool _cargando = false;
    private string? _mensajeError;
    private string? _mensajeExito;

    private int _pendientes => _matches.Count(m => !m.homeGoals.HasValue);
    private int _jugados    => _matches.Count(m =>  m.homeGoals.HasValue);

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        try
        {
            _matches = MatchService.GetAllMatches().ToList();
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
        }
    }

    private void SimularPendientes()
    {
        try
        {
            _cargando = true;
            _mensajeError = null;
            _mensajeExito = null;
            StateHasChanged();

            MatchService.SimulateGroupStage(); 
            CruceService.SimulateCruces();

            _mensajeExito = "Partidos simulados correctamente.";
            LoadData();
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }
}