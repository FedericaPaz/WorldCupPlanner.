@page "/matches/edit/{Id:int}"
@rendermode InteractiveServer
@using Domain.Entities
@using DTOs.Match
@using DTOs.Stadium
@using IServices
@using Web.Services
@inject IMatchService MatchService
@inject IStadiumService StadiumService
@inject NavigationManager Navigation
@inject TournamentConfig Config
@inject SessionService SessionService
@inject ILogService LogService

<div class="edit-match-page">
    <button class="back-link" @onclick="GoBack">← Volver a partidos</button>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="message error">@_errorMessage</div>
    }

    @if (_match is null)
    {
        <p>Cargando partido...</p>
    }
    else if (_match.isLocked)
    {
        <div class="alert alert-warning">
            Este partido no puede editarse porque los cruces eliminatorios ya fueron generados.
        </div>
    }
    else
    {
        <div class="edit-card">
            <div class="card-header">
                <i class="bi bi-trophy-fill"></i>
                <div>
                    <h3 class="card-title">Editar Partido</h3>
                    <p class="card-sub">@_match.homeTeamName vs @_match.awayTeamName</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-section">
                    <label>Fecha y hora</label>
                    <input class="form-control" type="datetime-local" @bind="_dateTime" />
                </div>
            </div>

            <div class="form-section">
                <label>Estadio</label>
                <select class="form-control" @bind="_stadiumName">
                    @foreach (var stadium in _stadiums)
                    {
                        <option value="@stadium.stadiumName">@stadium.stadiumName</option>
                    }
                </select>
            </div>

            <hr />

            <div class="result-header">
                <h4>Resultado</h4>
                <button class="simulate-btn" type="button" @onclick="SimulateResult">
                    <i class="bi bi-dice-5-fill"></i>
                    Simular resultado
                </button>
            </div>

            <div class="result-grid">
                <div class="team-result-card">
                    <label>Equipo Local</label>
                    <input class="form-control disabled" value="@_match.homeTeamName" disabled />

                    <label>Goles</label>
                    <input class="form-control goals-input" type="number" min="0" @bind="_homeGoals" />

                    <label>Amarillas</label>
                    <input class="form-control" type="number" min="0" @bind="_homeYellowCards" />

                    <label>Rojas</label>
                    <input class="form-control" type="number" min="0" @bind="_homeRedCards" />
                </div>

                <div class="team-result-card">
                    <label>Equipo Visitante</label>
                    <input class="form-control disabled" value="@_match.awayTeamName" disabled />

                    <label>Goles</label>
                    <input class="form-control goals-input" type="number" min="0" @bind="_awayGoals" />

                    <label>Amarillas</label>
                    <input class="form-control" type="number" min="0" @bind="_awayYellowCards" />

                    <label>Rojas</label>
                    <input class="form-control" type="number" min="0" @bind="_awayRedCards" />
                </div>
            </div>

            <div class="form-actions">
                <button class="btn-cancel" type="button" @onclick="GoBack">Cancelar</button>

                <button class="btn-submit" type="button" @onclick="SaveChanges">
                    Guardar cambios
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private MatchResponse? _match;
    private List<StadiumRequest> _stadiums = new();
    private string? _errorMessage;

    private DateTime _dateTime;
    private string _stadiumName = string.Empty;

    private int _homeGoals;
    private int _awayGoals;

    private int _homeYellowCards;
    private int _awayYellowCards;

    private int _homeRedCards;
    private int _awayRedCards;

    protected override void OnInitialized()
    {
        if (!SessionService.IsEditor())
        {
            Navigation.NavigateTo("/");
            return;
        }

        LoadData();
    }

    private void LoadData()
    {
        try
        {
            _match = MatchService.GetMatchById(Id);

            _stadiums = StadiumService.GetAllStadiums();

            _dateTime = _match.dateMatch;
            _stadiumName = _match.stadiumName;

            _homeGoals = _match.homeGoals ?? 0;
            _awayGoals = _match.awayGoals ?? 0;

            _homeYellowCards = _match.homeYellowCards;
            _awayYellowCards = _match.awayYellowCards;

            _homeRedCards = _match.homeRedCards;
            _awayRedCards = _match.awayRedCards;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SaveChanges()
    {
        try
        {
            if (_match is null) return;

            bool wasModified = false;

            if (_dateTime != _match.dateMatch)
            {
                MatchService.UpdateMatchDate(_match.idMatch, _dateTime);
                wasModified = true;
            }

            if (_stadiumName != _match.stadiumName)
            {
                MatchService.UpdateMatchStadium(_match.idMatch, _stadiumName);
                wasModified = true;
            }

            int currentHomeGoals = _match.homeGoals ?? 0;
            int currentAwayGoals = _match.awayGoals ?? 0;

            bool goalsChanged =
                _homeGoals != currentHomeGoals ||
                _awayGoals != currentAwayGoals;

            bool cardsChanged =
                _homeYellowCards != _match.homeYellowCards ||
                _awayYellowCards != _match.awayYellowCards ||
                _homeRedCards != _match.homeRedCards ||
                _awayRedCards != _match.awayRedCards;
            
            bool resultChanged = goalsChanged || cardsChanged;

            if (resultChanged)
            {
                var request = new MatchResultRequest
                {
                    homeGoals = _homeGoals,
                    awayGoals = _awayGoals,
                    homeYellowCards = _homeYellowCards,
                    awayYellowCards = _awayYellowCards,
                    homeRedCards = _homeRedCards,
                    awayRedCards = _awayRedCards
                };

                MatchService.SetMatchResult(_match.idMatch, request);

                wasModified = true;
            }

            if (wasModified)
            {
                LogService.Register(
                    GetCurrentUserEmail(),
                    "Partidos",
                    "Modificación",
                    $"Se modificó el partido {_match.homeTeamName} vs {_match.awayTeamName}"
                );
            }

            Navigation.NavigateTo("/matches");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SimulateResult()
    {
        try
        {
            if (_match is null)
                return;

            var randomSeed = new Random().Next(); 
            MatchService.SimulateMatch(_match.idMatch, randomSeed);

            LogService.Register(
                GetCurrentUserEmail(),
                "Partidos",
                "Modificación",
                $"Se simuló el resultado del partido {_match.homeTeamName} vs {_match.awayTeamName}"
            );

            LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/matches");
    }

    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser().Email;
    }
}