@page "/logs"
@using DTOs.Log
@using IServices
@using Web.Services
@inject ILogService LogService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Log del sistema</PageTitle>

<div class="logs-page">
    <div class="logs-header">
        <div>
            <span class="logs-eyebrow">Auditoría</span>
            <h1>Log del sistema</h1>
            <p>Registro de acciones realizadas dentro de WorldCup Planner 2026.</p>
        </div>

        <div class="logs-counter">
            <span class="logs-counter-number">@_logs.Count</span>
            <span class="logs-counter-label">registros</span>
        </div>
    </div>

    <div class="logs-card">
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">
                @_errorMessage
            </div>
        }
        else if (_logs.Count == 0)
        {
            <div class="logs-empty">
                <div class="logs-empty-icon">📝</div>
                <h3>No hay registros todavía</h3>
                <p>Las acciones auditadas aparecerán en esta pantalla.</p>
            </div>
        }
        else
        {
            <div class="logs-table-wrapper">
                <table class="logs-table">
                    <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Categoría</th>
                        <th>Acción</th>
                        <th>Detalle</th>
                    </tr>
                    </thead>

                    <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr>
                            <td class="logs-date">
                                @ToUruguayTime(log.Timestamp).ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <span class="logs-user">@log.UserEmail</span>
                            </td>

                            <td>
                                <span class="logs-badge category">
                                    @log.Category
                                </span>
                            </td>

                            <td>
                                <span class="logs-badge action">
                                    @log.Action
                                </span>
                            </td>

                            <td class="logs-detail">
                                @log.Detail
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<LogEntryDTO> _logs = new();
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        if (!SessionService.IsSystemAdministrator())
        {
            Navigation.NavigateTo("/");
            return;
        }

        LoadLogs();
    }

    private void LoadLogs()
    {
        try
        {
            _errorMessage = string.Empty;

            _logs = LogService.GetAll()
                .OrderByDescending(log => log.Timestamp)
                .ToList();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private static DateTime ToUruguayTime(DateTime timestamp)
    {
        var utcTimestamp = timestamp.Kind == DateTimeKind.Utc
            ? timestamp
            : DateTime.SpecifyKind(timestamp, DateTimeKind.Utc);

        return TimeZoneInfo.ConvertTimeFromUtc(utcTimestamp, GetUruguayTimeZone());
    }

    private static TimeZoneInfo GetUruguayTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Montevideo");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Montevideo Standard Time");
        }
    }
}