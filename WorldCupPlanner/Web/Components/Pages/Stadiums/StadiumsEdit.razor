@page "/stadiums/edit/{Name}"

@using DTOs
@using IServices
@using Web.Services

@inject IStadiumService Service
@inject ILogService LogService
@inject SessionService SessionService
@inject NavigationManager Navigation

@if (_request == null)
{
    <p>Loading...</p>
}
else
{
    <div class="stadiums-create">

        <div class="back-link">
            <button class="btn-cancel" @onclick="NavigateBack">
                ← Volver a estadios
            </button>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <h3 class="card-title">Editar Estadio</h3>
                    <p class="card-sub">Modificá la información del estadio</p>
                </div>
            </div>

            <EditForm Model="_request" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-message">@_errorMessage</div>
                }

                @if (_request is not null)
                {
                    <ValidationSummary class="error-message" />
                }

                <div class="form-section">
                    <label>Nombre del Estadio <span style="color:red">*</span></label>
                    <InputText class="form-control" @bind-Value="_request.stadiumName" />
                    <ValidationMessage For="@(() => _request.stadiumName)" />
                </div>

                <div class="form-section">
                    <label>Ciudad <span style="color:red">*</span></label>
                    <InputText class="form-control" @bind-Value="_request.stadiumCity" />
                    <ValidationMessage For="@(() => _request.stadiumCity)" />
                </div>

                <div class="form-section">
                    <label>Capacidad <span style="color:red">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_request.locativeCapacity" />
                    <ValidationMessage For="@(() => _request.locativeCapacity)" />
                </div>

                <div class="form-section">
                    <label>Descripción</label>
                    <InputTextArea class="form-control" @bind-Value="_request.stadiumDescription" />
                    <ValidationMessage For="@(() => _request.stadiumDescription)" />
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel" @onclick="NavigateBack">
                        Cancelar
                    </button>

                    <button type="submit" class="btn-submit">
                        Guardar cambios
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public string? Name { get; set; }

    private StadiumRequest? _request;
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        if (!SessionService.IsSystemAdministrator())
        {
            Navigation.NavigateTo("/");
            return;
        }

        var stadium = Service.GetAllStadiums()
            .FirstOrDefault(s => s.stadiumName.Equals(
                Uri.UnescapeDataString(Name ?? ""),
                StringComparison.OrdinalIgnoreCase));

        if (stadium == null)
        {
            Navigation.NavigateTo("/stadiums");
            return;
        }

        _request = new StadiumRequest
        {
            stadiumName = stadium.stadiumName,
            stadiumCity = stadium.stadiumCity,
            stadiumDescription = stadium.stadiumDescription,
            locativeCapacity = stadium.locativeCapacity
        };
    }
    
    private void NavigateBack()
    {
        Navigation.NavigateTo("/stadiums");
    }

    private void HandleSubmit()
    {
        _errorMessage = string.Empty;

        try
        {
            var originalName = Uri.UnescapeDataString(Name!);

            Service.DeleteStadium(originalName);
            Service.AddStadium(_request!);

            LogService.Register(
                GetCurrentUserEmail(),
                "Estadios",
                "Edición",
                $"Se editó el estadio {originalName}"
            );

            Navigation.NavigateTo("/stadiums");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser().Email;
    }
}