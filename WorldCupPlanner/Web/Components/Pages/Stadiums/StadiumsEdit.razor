@page "/stadiums/edit/{Name}"

@using DTOs
@using IServices
@using Web.Services

@inject IStadiumService Service
@inject ILogService LogService
@inject SessionService SessionService
@inject NavigationManager Navigation

@if (_request == null)
{
    <p>Loading...</p>
}
else
{
    <a href="/stadiums" style="color: gray; text-decoration: none;">
        ← Volver a estadios
    </a>

    <div class="stadium-form-container">
        <div class="form-header">
            <div class="form-icon">🏟️</div>
            <div>
                <h3 class="form-title">Editar Estadio</h3>
                <p class="form-subtitle">Modificá la información del estadio</p>
            </div>
        </div>

        <EditForm Model="_request" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="message error">@_errorMessage</div>
            }

            <h4>Información Básica</h4>

            <div class="form-group">
                <label class="form-label">Nombre del Estadio <span class="required">*</span></label>
                <InputText @bind-Value="_request.stadiumName" placeholder="ej: MetLife Stadium" class="form-input" />
                <ValidationMessage For="@(() => _request.stadiumName)" />
            </div>

            <div class="form-group">
                <label class="form-label">Ciudad <span class="required">*</span></label>
                <InputText @bind-Value="_request.stadiumCity" placeholder="ej: Montevideo" class="form-input" />
                <ValidationMessage For="@(() => _request.stadiumCity)" />
            </div>

            <div class="form-group">
                <label class="form-label">Capacidad <span class="required">*</span></label>
                <InputNumber @bind-Value="_request.locativeCapacity" placeholder="ej: 60000" class="form-input" />
                <ValidationMessage For="@(() => _request.locativeCapacity)" />
            </div>

            <div class="form-group">
                <label class="form-label">Descripción</label>
                <InputTextArea @bind-Value="_request.stadiumDescription" placeholder="Descripción opcional..." class="form-input form-textarea" />
                <ValidationMessage For="@(() => _request.stadiumDescription)" />
            </div>

            <div class="form-actions">
                <a href="/stadiums" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-submit">Guardar cambios</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public string? Name { get; set; }

    private StadiumRequest? _request;
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        if (!SessionService.IsSystemAdministrator())
        {
            Navigation.NavigateTo("/");
            return;
        }

        var stadium = Service.GetAllStadiums()
            .FirstOrDefault(s => s.stadiumName.Equals(
                Uri.UnescapeDataString(Name ?? ""),
                StringComparison.OrdinalIgnoreCase));

        if (stadium == null)
        {
            Navigation.NavigateTo("/stadiums");
            return;
        }

        _request = new StadiumRequest
        {
            stadiumName = stadium.stadiumName,
            stadiumCity = stadium.stadiumCity,
            stadiumDescription = stadium.stadiumDescription,
            locativeCapacity = stadium.locativeCapacity
        };
    }

    private void HandleSubmit()
    {
        _errorMessage = string.Empty;

        try
        {
            var originalName = Uri.UnescapeDataString(Name!);

            Service.DeleteStadium(originalName);
            Service.AddStadium(_request!);

            LogService.Register(
                GetCurrentUserEmail(),
                "Estadios",
                "Edición",
                $"Se editó el estadio {originalName}"
            );

            Navigation.NavigateTo("/stadiums");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private string GetCurrentUserEmail()
    {
        if (!SessionService.IsUserActive())
        {
            return "Sistema";
        }

        return SessionService.GetCurrentUser().Email;
    }
}