@page "/stadiums"
@using Domain
@using Services
@inject StadiumService Service
@inject NavigationManager Navigation

<div style="padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
        <div>
            <h3 style="margin: 0;">Gestión de Estadios</h3>
            <p style="color: gray; font-size: 14px; margin: 0;">@_stadiums.Count estadios registrados</p>
        </div>
        <a href="/stadiums/create" style="background: green; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; text-decoration: none; display: inline-block;">
            + Crear estadio
        </a>
        <button @onclick="GoToCreate" style="background: green; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px;">
            + Crear Estadio
        </button>
    </div>
    
    @if (_errorMessage != null)
    {
        <div style="color: red; margin-bottom: 1rem;">@_errorMessage</div>
    }

    @if (_successMessage != null)
    {
        <div style="color: green; margin-bottom: 1rem;">@_successMessage</div>
    }
    
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
        @foreach (var stadium in _stadiums)
        {
            <div style="border: 1px solid #e0e0e0; border-radius: 12px; padding: 1rem; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div style="background: #e8f5e9; padding: 8px; border-radius: 8px;">
                        📍
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button @onclick="() => GoToEdit(stadium.Name)" 
                                style="background: none; border: none; cursor: pointer; color: gray;">
                            ✏️
                        </button>
                        <button @onclick="() => HandleDelete(stadium.Name)" 
                                style="background: none; border: none; cursor: pointer; color: red;">
                            🗑️
                        </button>
                    </div>
                </div>
                <h4 style="margin: 0.75rem 0 0.25rem;">@stadium.Name</h4>
                <p style="color: gray; font-size: 14px; margin: 0 0 0.5rem;">@stadium.City</p>
                @if (stadium.Description != null)
                {
                    <p style="color: gray; font-size: 13px; margin: 0 0 0.5rem;">@stadium.Description</p>
                }
                <p style="font-size: 14px; margin: 0;">
                    Capacidad: <strong>@stadium.LocativeCapacity.ToString("N0") personas</strong>
                </p>
            </div>
        }
    </div>
</div>



