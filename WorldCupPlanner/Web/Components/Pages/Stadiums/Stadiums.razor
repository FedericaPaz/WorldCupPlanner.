@page "/stadiums"
@using Domain
@using Services
@inject StadiumService Service

@if (_stadiums == null)
{
    <p>Loading...</p>
}
else
{
    <div style="padding: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <div>
                <h3 style="margin: 0;">Gestión de Estadios</h3>
                <p style="color: gray; font-size: 14px; margin: 0;">@_stadiums.Count() estadios registrados</p>
            </div>
            <a href="/stadiums/create" style="background: green; color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; text-decoration: none; display: inline-block;">
                + Crear estadio
            </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
            @foreach (var stadium in _stadiums)
            {
                <div style="border: 1px solid #e0e0e0; border-radius: 12px; padding: 1rem; background: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="background: #e8f5e9; padding: 8px; border-radius: 8px;">📍</div>
                        <div style="display: flex; gap: 8px;">
                            <a href="/stadiums/edit/@stadium.StadiumName"
                               style="background: none; border: none; cursor: pointer; color: gray; text-decoration: none;">✏️</a>
                            <button @onclick="() => HandleDelete(stadium.StadiumName)" style="background: none; border: none; cursor: pointer; color: red;">🗑️</button>
                        </div>
                    </div>
                    <h4 style="margin: 0.75rem 0 0.25rem;">@stadium.StadiumName</h4>
                    <p style="color: gray; font-size: 14px; margin: 0 0 0.5rem;">@stadium.CityName</p>
                    @if (stadium.StadiumDescription != null)
                    {
                        <p style="color: gray; font-size: 13px; margin: 0 0 0.5rem;">@stadium.StadiumDescription</p>
                    }
                    <p style="font-size: 14px; margin: 0;">
                        Capacidad: <strong>@stadium.LocativeCapacity.ToString("N0") personas</strong>
                    </p>
                </div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="color: red; margin-top: 1rem;">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div style="color: green; margin-top: 1rem;">@_successMessage</div>
}

@code
{
    private IEnumerable<Stadium>? _stadiums;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    protected override void OnInitialized()
    {
        _stadiums = Service.GetAllStadiums();
    }

    private void HandleDelete(string name)
    {
        _errorMessage = string.Empty;
        try
        {
            Service.DeleteStadium(name);
            _stadiums = Service.GetAllStadiums();
            _successMessage = "Estadio eliminado correctamente.";
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }  
}

