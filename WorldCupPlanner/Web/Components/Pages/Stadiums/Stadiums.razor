@page "/stadiums"
@rendermode InteractiveServer
@using System
@using Domain
@using DTOs
@using IServices
@inject IStadiumService Service
@inject NavigationManager NavigationManager
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

@if (_stadiums == null)
{
    <p>Loading...</p>
}
else
{
    <div class="stadiums-container">
        <div class="stadiums-header">
            <div>
                <h3 class="title">Gestión de Estadios</h3>
                <p class="subtitle">@_stadiums.Count() estadios registrados</p>
            </div>
            <button class="create-btn" @onclick="NavigateToCreate">+ Crear estadio</button>
        </div>

        <div class="stadiums-grid">
            @foreach (var stadium in _stadiums)
            {
                <div class="stadium-card" @key="stadium.stadiumName">
                    <div class="card-top">
                        <div class="icon">📍</div>
                        <div class="card-actions">
                            <button class="icon-btn edit-btn" @onclick="@(() => NavigateToEdit(stadium.stadiumName))" aria-label="Editar estadio">✏️</button>
                            <button class="icon-btn delete-btn" @onclick="() => HandleDelete(stadium.stadiumName)" aria-label="Eliminar estadio">🗑️</button>
                        </div>
                    </div>

                    <h4 class="stadium-name">@stadium.stadiumName</h4>
                    <p class="stadium-city">@stadium.stadiumCity</p>
                    @if (!string.IsNullOrEmpty(stadium.stadiumDescription))
                    {
                        <p class="stadium-desc">@stadium.stadiumDescription</p>
                    }
                    <p class="stadium-capacity">Capacidad: <strong>@stadium.locativeCapacity.ToString("N0") personas</strong></p>
                </div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="message error">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="message success">@_successMessage</div>
}

@code
{
    private IEnumerable<StadiumRequest.StadiumResponseDTO>? _stadiums;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    protected override Task OnInitializedAsync()
    {
        _stadiums = Service.GetAllStadiums();
        return Task.CompletedTask;
    }

    private void NavigateToCreate() => NavigationManager.NavigateTo("/stadiums/create");

    private void NavigateToEdit(string name) => NavigationManager.NavigateTo($"/stadiums/edit/{Uri.EscapeDataString(name)}");

    private async Task HandleDelete(string name)
    {
        _errorMessage = string.Empty;
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Eliminar estadio '{name}'?");
            if (!confirmed)
                return;

            Service.DeleteStadium(name);
            _stadiums = Service.GetAllStadiums();
            _successMessage = "Estadio eliminado correctamente.";
            StateHasChanged();

            // auto-hide success message
            await Task.Delay(3000);
            _successMessage = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
