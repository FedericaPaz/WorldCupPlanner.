@page "/stadium/create"
@using Domain
@using Services
@inject StadiumService Service
@inject NavigationManager Navigation

<a href="/stadiums" style="color: gray; text-decoration: none;">
    ← Volver a estadios
</a>

<div style="border: 1px solid #e0e0e0; border-radius: 12px; padding: 1.5rem; background: white; margin-top: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
        <div style="background: #e8f5e9; padding: 10px; border-radius: 8px; font-size: 24px;">🏟️</div>
        <div>
            <h3 style="margin: 0;">Crear Estadio</h3>
            <p style="color: gray; font-size: 14px; margin: 0;">Complete cel formulario con la información del estadio</p>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div style="color: red; margin-bottom: 1rem;">@_errorMessage</div>
    }
    
    <h4>Información sobre el estadio</h4>
    
    <div style="margin-bottom: 1rem;">
        <label style="font-size: 13px; color: gray;">Nombre del estadio: <span style="color: red;">*</span></label>
        <input @bind="_name" placeholder="ej: Hard Rock Stadium" style="width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 8px; margin-top: 4px;" />
    </div>
    
    <div style="margin-bottom: 1rem;">
        <label style="font-size: 13px; color: gray;">Ciudad del estadio: <span style="color: red;">*</span></label>
        <input @bind="_city" placeholder="ej: Miami" style="width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 8px; margin-top: 4px;" />
    </div>
    
    <div style="margin-bottom: 1rem;">
        <label style="font-size: 13px; color: gray;">Capacidad <span style="color: red;">*</span></label>
        <input type="number" @bind="_locativeCapacity" placeholder="ej: 60000" style="width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 8px; margin-top: 4px;" />
    </div>
    
    <div style="margin-bottom: 1.5rem;">
        <label style="font-size: 13px; color: gray;">Descripción del estadio:</label>
        <textarea @bind="_description" placeholder="Descripción opcional del estadio..." style="width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 8px; margin-top: 4px; min-height: 80px;"></textarea>
    </div>
    
    <div style="display: flex; gap: 1rem;">
        <a href="/stadiums" style="flex: 1; padding: 12px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; text-align: center; text-decoration: none; color: black;">
            Cancelar
        </a>
        <button @onclick="HandleSubmit" style="flex: 1; padding: 12px; background: green; color: white; border: none; border-radius: 8px; cursor: pointer;">
            Crear estadio
        </button>
    </div>
</div>

@code {
    
}