@page "/stadiums/create"
@using System.ComponentModel.DataAnnotations
@using DTOs
@using IServices
@inject IStadiumService Service
@inject NavigationManager Navigation

<div class="stadiums-create">
    <div class="back-link">
        <button class="btn-cancel" @onclick="NavigateBack">← Volver a estadios</button>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="icon">🏟️</div>
            <div>
                <h3 class="card-title">Crear Nuevo Estadio</h3>
                <p class="card-sub">Complete la información del estadio</p>
            </div>
        </div>

        <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="message error">@_errorMessage</div>
            }

            <div class="form-section">
                <label for="name">Nombre del Estadio <span aria-hidden="true" style="color:red">*</span></label>
                <InputText id="name" class="form-control" @bind-Value="_model.StadiumName" />
                <ValidationMessage For="@(() => _model.StadiumName)" />
            </div>

            <div class="form-section">
                <label for="city">Ciudad <span aria-hidden="true" style="color:red">*</span></label>
                <InputText id="city" class="form-control" @bind-Value="_model.CityName" />
                <ValidationMessage For="@(() => _model.CityName)" />
            </div>

            <div class="form-section">
                <label for="capacity">Capacidad <span aria-hidden="true" style="color:red">*</span></label>
                <InputNumber id="capacity" class="form-control" @bind-Value="_model.LocativeCapacity" />
                <ValidationMessage For="@(() => _model.LocativeCapacity)" />
            </div>

            <div class="form-section">
                <label for="desc">Descripción</label>
                <InputTextArea id="desc" class="form-control" @bind-Value="_model.StadiumDescription" />
                <ValidationMessage For="@(() => _model.StadiumDescription)" />
            </div>

            <div class="form-actions">
                <button type="button" class="btn-cancel" @onclick="NavigateBack">Cancelar</button>
                <button type="submit" class="btn-submit" disabled="@_isSubmitting">@(_isSubmitting ? "Creando..." : "Crear estadio")</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private StadiumInputModel _model = new StadiumInputModel();
    private string _errorMessage = string.Empty;
    private bool _isSubmitting = false;

    private void NavigateBack() => Navigation.NavigateTo("/stadiums");

    private async Task HandleValidSubmit()
    {
        _errorMessage = string.Empty;
        _isSubmitting = true;
        try
        {
            // UI-side: build DTO; business rules remain in Service
            var dto = new StadiumDTOs.CreateStadiumDTO
            {
                stadiumName = _model.StadiumName?.Trim() ?? string.Empty,
                stadiumCity = _model.CityName?.Trim() ?? string.Empty,
                stadiumDescription = _model.StadiumDescription?.Trim(),
                locativeCapacity = _model.LocativeCapacity
            };
            Service.AddStadium(dto);
            Navigation.NavigateTo("/stadiums");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
            await Task.CompletedTask;
        }
    }

    private class StadiumInputModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio")]
        [StringLength(80, ErrorMessage = "El nombre debe tener como máximo 80 caracteres")]
        public string? StadiumName { get; set; }

        [Required(ErrorMessage = "La ciudad es obligatoria")]
        [StringLength(60, ErrorMessage = "La ciudad debe tener como máximo 60 caracteres")]
        public string? CityName { get; set; }

        [StringLength(400, ErrorMessage = "La descripción debe tener como máximo 400 caracteres")]
        public string? StadiumDescription { get; set; }

        [Range(20000, int.MaxValue, ErrorMessage = "La capacidad debe ser al menos 20000")]
        public int LocativeCapacity { get; set; } = 20000;
    }
}