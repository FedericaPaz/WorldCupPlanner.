@page "/change-password"
@using IServices
@using IServices.UserInterfaces
@using Web.Services
@inject IUserEditService UserService
@inject SessionService SessionService
@inject NavigationManager Navigation
@inject ILogService LogService

<div class="auth-page">
    <div class="auth-card auth-card-large">
        <h3>Change Password</h3>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-error">@_errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="auth-success">@_successMessage</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleChange">
            <div class="auth-field">
                <label>New password</label>
                <InputText class="auth-input" type="password" @bind-Value="_model.NewPassword" />
            </div>

            <div class="auth-field">
                <label>Confirm password</label>
                <InputText class="auth-input" type="password" @bind-Value="_model.ConfirmPassword" />
            </div>

            <button type="submit" class="auth-button">Change password</button>
        </EditForm>
    </div>
</div>

@code {
    private ChangePasswordModel _model = new();
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    protected override void OnInitialized()
    {
        if (!SessionService.IsUserActive())
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void HandleChange()
    {
        try
        {
            _errorMessage = string.Empty;
            _successMessage = string.Empty;

            if (_model.NewPassword != _model.ConfirmPassword)
            {
                _errorMessage = "Passwords do not match.";
                return;
            }

            var current = SessionService.GetCurrentUser();
            if (current is null)
            {
                _errorMessage = "User not logged in.";
                return;
            }

            UserService.ChangeOwnPassword(current.Email, _model.NewPassword);

            LogService.Register(current.Email, "Usuarios", "Cambio de contraseña", $"El usuario {current.Email} cambió su contraseña");

            _successMessage = "Password changed successfully.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private class ChangePasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
