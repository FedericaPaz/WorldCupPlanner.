@page "/login"
@using Web.Services
@using DTOs
@inject SessionService SessionService
@inject NavigationManager Navigation

<h3>Iniciar sesión</h3>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<EditForm Model="_request" OnValidSubmit="HandleLogin">
    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="_request.Email" />
    </div>
    <div class="mb-3">
        <label>Contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="_request.Password" />
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button type="submit" class="btn btn-primary">Ingresar</button>
        <a href="/register" class="btn btn-outline-secondary">Registrarse</a>
    </div>
</EditForm>

@code {
    private LoginRequest _request = new();
    private string _errorMessage = "";

    private async Task HandleLogin()
    {
        try
        {
            await SessionService.Login(_request);
            Navigation.NavigateTo("/");
        }
        catch (Exception)
        {
            _errorMessage = "Credenciales Inválidas.";
        }
    }
}