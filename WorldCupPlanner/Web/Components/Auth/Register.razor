@page "/register"
@using DTOs
@using IServices
@inject IAuthService AuthService
@inject NavigationManager Navigation

<h3>Registrarse</h3>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<EditForm Model="_request" OnValidSubmit="HandleRegister">
    <div class="mb-3">
        <label>Nombre</label>
        <InputText class="form-control" @bind-Value="_request.FirstName" />
    </div>
    <div class="mb-3">
        <label>Apellido</label>
        <InputText class="form-control" @bind-Value="_request.LastName" />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="_request.Email" />
    </div>
    <div class="mb-3">
        <label>Contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="_request.Password" />
    </div>
    <div class="mb-3">
        <label>Fecha Nacimiento</label>
        <InputNumber class="form-control" @bind-Value="_request.BirthDate" />
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button type="submit" class="btn btn-success">Crear cuenta</button>
        <a href="/login" class="btn btn-outline-secondary">Ya tengo cuenta</a>
    </div>
</EditForm>

@code {
    private RegisterRequest _request = new();
    private string _errorMessage = "";

    private void HandleRegister()
    {
        try
        {
            AuthService.Register(_request);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}